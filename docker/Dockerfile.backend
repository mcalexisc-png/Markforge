# syntax=docker/dockerfile:1
FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        tesseract-ocr \
        tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt backend/requirements-ocr.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ocr.txt

COPY backend/app ./app
COPY backend/converters ./converters
COPY backend/document_model ./document_model
COPY backend/markdown ./markdown
COPY backend/workers ./workers

RUN mkdir -p /data/storage /data/uploads /data/jobs
ENV MARKFORGE_DATA_DIR=/data \
    MARKFORGE_STORAGE_DIR=/data/storage \
    MARKFORGE_UPLOAD_DIR=/data/uploads \
    MARKFORGE_JOB_DIR=/data/jobs \
    MARKFORGE_DB_PATH=/data/markforge.db

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:3001/api/health || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "3001"]
