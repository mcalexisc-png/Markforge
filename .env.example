# ------------------------------------------------------------------
# Markforge environment configuration
# Copy to .env and adjust. NEVER commit real .env files.
# ------------------------------------------------------------------

# Runtime
MARKFORGE_APP_ENV=development            # development | production
MARKFORGE_HOST=127.0.0.1                 # 127.0.0.1 = local-only. 0.0.0.0 = LAN mode.
MARKFORGE_PORT=3001                      # Backend API port
MARKFORGE_LOG_LEVEL=INFO

# LAN access
MARKFORGE_LAN_MODE=false                 # true exposes the app to your local network
MARKFORGE_LAN_PASSWORD=                  # optional simple password protecting LAN access

# Job execution
#   sync   - jobs run in-process (no Redis needed, simplest local setup)
#   celery - jobs run in the Celery worker via Redis (recommended for Docker/LAN)
MARKFORGE_JOB_MODE=sync
MARKFORGE_REDIS_URL=redis://localhost:6379/0
MARKFORGE_JOB_TIMEOUT=900                # seconds before a conversion is aborted
MARKFORGE_WORKER_CONCURRENCY=2

# Storage
MARKFORGE_STORAGE_DIR=storage
MARKFORGE_DATABASE_PATH=storage/markforge.db
MARKFORGE_UPLOAD_DIR=storage/uploads
MARKFORGE_OUTPUT_DIR=storage/outputs
MARKFORGE_TEMP_DIR=storage/temp
MARKFORGE_RETENTION_PERIOD=7             # days to keep finished conversion outputs
MARKFORGE_CLEANUP_INTERVAL=3600          # seconds between cleanup runs

# Limits
MARKFORGE_MAX_FILE_SIZE=104857600        # 100 MB per file
MARKFORGE_MAX_FILES_PER_JOB=25
MARKFORGE_SECRET_KEY=change-me           # used to sign the LAN access cookie

# Frontend (Next.js)
# API proxy target used by the Next.js server to reach the backend.
# Local dev:   http://127.0.0.1:3001
# Docker:      http://backend:3001
NEXT_PUBLIC_APP_NAME=Markforge
API_PROXY_TARGET=http://127.0.0.1:3001
